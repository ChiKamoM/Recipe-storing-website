<%- include("partials/header.ejs") %>
<div class="center-box">
<form action="/login" method="post" class=" form register-form">
     <h2 class="box-heading">Loginn below</h2>
      <% if (locals.errorMessage) { %>
            <p class="error-text"><%= errorMessage %> </p>
      <% } %>
     
      <input placeholder="Email" type="email" name="email">

      
      <input placeholder="Password" type="password" name="password">
      <button class="submit-form-button" type="submit">Login</button>
</form>
      <form action="/" method="get">
            <p>Don't have an account? <button class="login-redirect">register</button></p>
      </form>
</div>

<%- include("partials/footer.ejs") %>